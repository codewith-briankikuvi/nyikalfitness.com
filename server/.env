# SMTP Configuration for Email Sending
# Replace these with your actual SMTP credentials
# For Gmail, you'll need to use an App Password: https://support.google.com/accounts/answer/185833

# SMTP Host (e.g., smtp.gmail.com for Gmail)
SMTP_HOST=smtp.gmail.com

# SMTP Port (587 for TLS, 465 for SSL)
SMTP_PORT=587

# SMTP Username (your email address)
SMTP_USER=charlesnyikal52@gmail.com

# SMTP Password (use App Password for Gmail)
SMTP_PASS=vrul rmhq qxvg vjgn

# From email address (can be same as SMTP_USER)
SMTP_FROM=charlesnyikal52@gmail.com
